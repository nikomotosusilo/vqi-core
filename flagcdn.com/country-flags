// FULL 195 AUTO FETCH dari flagcdn + restcountries (biar gak tulis manual 195)
async function loadAll195Flags(){
  try {
    let res = await fetch('https://restcountries.com/v3.1/all?fields=cca2,name,currencies,flags');
    let data = await res.json();
    let sorted = data.sort((a,b)=>a.name.common.localeCompare(b.name.common));
    COUNTRIES_195.length = 0; // clear sample
    sorted.forEach(c=>{
      let code = c.cca2;
      let cur = c.currencies? Object.keys(c.currencies)[0] : "USD";
      COUNTRIES_195.push({
        code: code,
        name: c.name.common,
        flag: code.toUpperCase().replace(/./g, char => String.fromCodePoint(127397 + char.charCodeAt())),
        currency: cur,
        cdn: `https://flagcdn.com/w40/${code.toLowerCase()}.png`
      });
    });
    console.log("195 Flags loaded:", COUNTRIES_195.length);
    renderFlagSelect();
  } catch(e){
    console.log("Fallback ke sample 15 negara, API restcountries error", e);
    renderFlagSelect();
  }
}

function renderFlagSelect(){
  let sel = document.getElementById('country');
  if(!sel) return;
  sel.innerHTML = COUNTRIES_195.map(c=>
    `<option value="${c.code}" data-cdn="${c.cdn}">${c.flag} ${c.name} - ${c.currency}</option>`
  ).join('');

  // preview flag image
  sel.addEventListener('change', (e)=>{
    let opt = e.target.selectedOptions[0];
    let cdn = opt.getAttribute('data-cdn');
    let img = document.getElementById('flag-preview');
    if(img) img.src = cdn;
    localStorage.setItem('vqi_country', e.target.value);
  });
}

// Panggil saat Sign Up page load
document.addEventListener('DOMContentLoaded', ()=>{
  loadAll195Flags();
});
